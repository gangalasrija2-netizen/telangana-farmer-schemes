# Copy this file to .env and set a long random SECRET_KEY.
SECRET_KEY=replace-this-with-a-long-random-secret
# Easy local mode (works without installing MySQL):
DATABASE_URL=sqlite:///farmer_schemes.db
# For MySQL, replace DATABASE_URL with:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/telangana_farmer_schemes?charset=utf8mb4
